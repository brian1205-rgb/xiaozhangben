rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isMember(data) {
      return signedIn() && myEmail() in data.memberEmails;
    }
    match /ledgers/{lid} {
      allow read: if isMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.type in ['personal', 'family']
        && myEmail() in request.resource.data.memberEmails
        && request.resource.data.memberEmails.size() <= 20
        && (request.resource.data.type == 'family'
          || (lid == 'p_' + request.auth.uid && request.resource.data.memberEmails.size() == 1));
      allow update: if isMember(resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.type == resource.data.type
        && (request.resource.data.memberEmails == resource.data.memberEmails
          || (resource.data.type == 'family'
            && resource.data.owner == request.auth.uid
            && myEmail() in request.resource.data.memberEmails
            && request.resource.data.memberEmails.size() <= 20));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /txs/{tid} {
        allow read, write: if isMember(get(/databases/$(database)/documents/ledgers/$(lid)).data);
      }
    }
    // 給 AI 讀分類的 API：知道金鑰（文件 id）才能讀這一份，不能列出；只有帳本成員能建立、更新、刪除
    match /apiKeys/{key} {
      allow get: if true;
      allow create, update: if key.size() >= 24
        && request.resource.data.ledgerId is string
        && isMember(get(/databases/$(database)/documents/ledgers/$(request.resource.data.ledgerId)).data)
        && (resource == null || resource.data.ledgerId == request.resource.data.ledgerId);
      allow delete: if isMember(get(/databases/$(database)/documents/ledgers/$(resource.data.ledgerId)).data);
    }
  }
}
